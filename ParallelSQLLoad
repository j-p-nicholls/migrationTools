<#
.SYNOPSIS
    Runs one or more long-running queries across multiple simultaneous connections
    (threads) and reports connection and query timings per thread. Query output is
    discarded. No command timeout by default. Works on Windows PowerShell 5.1 and 7+.

.PARAMETER ThreadCount
    Number of simultaneous connections.

.PARAMETER Query
    One or more inline T-SQL statements.

.PARAMETER QueryFile
    One or more .sql files (no GO separators). Combined with -Query; inline queries come first.

.PARAMETER QueryAssignment
    All        - every thread runs every query, in order, on its own connection (default).
    RoundRobin - thread N runs only query ((N-1) mod QueryCount)+1, so queries are spread across threads.

.EXAMPLE
    .\Invoke-LongQuery-Parallel.ps1 -Server sqlserver01 -Database AppDb -ThreadCount 5 `
        -Query "SELECT COUNT(*) FROM dbo.BigTable"

.EXAMPLE
    .\Invoke-LongQuery-Parallel.ps1 -Server sqlserver01 -Database AppDb -ThreadCount 6 `
        -QueryFile .\report1.sql, .\report2.sql, .\report3.sql -QueryAssignment RoundRobin
#>
[CmdletBinding()]
param(
    [Parameter(Mandatory)][string]$Server,
    [string]$Database = 'master',
    [string[]]$Query,
    [string[]]$QueryFile,
    [ValidateRange(1, 200)][int]$ThreadCount = 1,
    [ValidateSet('All', 'RoundRobin')][string]$QueryAssignment = 'All',
    [int]$QueryTimeoutSeconds = 0,                    # 0 = no timeout
    [int]$ConnectTimeoutSeconds = 15,
    [int]$HeartbeatSeconds = 30,
    [System.Management.Automation.PSCredential]$Credential,   # omit for Windows integrated auth
    [switch]$MultiSubnetFailover,
    [switch]$TrustServerCertificate
)

# ---------- Build the query list ----------
$queryList = New-Object System.Collections.Generic.List[object]
foreach ($q in @($Query)) {
    if ($q) { $queryList.Add([pscustomobject]@{ Label = "Q$($queryList.Count + 1)"; Text = $q; Source = 'inline' }) }
}
foreach ($f in @($QueryFile)) {
    if ($f) {
        if (-not (Test-Path $f)) { throw "Query file not found: $f" }
        $queryList.Add([pscustomobject]@{
            Label  = "Q$($queryList.Count + 1)"
            Text   = (Get-Content -Path $f -Raw)
            Source = (Split-Path $f -Leaf)
        })
    }
}
if ($queryList.Count -eq 0) { throw "Specify at least one -Query or -QueryFile." }

# ---------- Connection string ----------
$sb = New-Object System.Data.SqlClient.SqlConnectionStringBuilder
$sb['Data Source']      = $Server
$sb['Initial Catalog']  = $Database
$sb['Connect Timeout']  = $ConnectTimeoutSeconds
$sb['Application Name'] = 'LongQueryParallel'
$sb['Pooling']          = $false                 # every thread gets its own genuine connection
if ($MultiSubnetFailover)    { $sb['MultiSubnetFailover'] = $true }
if ($TrustServerCertificate) { $sb['TrustServerCertificate'] = $true }
if ($Credential) {
    $sb['User ID']  = $Credential.UserName
    $sb['Password'] = $Credential.GetNetworkCredential().Password
} else {
    $sb['Integrated Security'] = $true
}
$connString = $sb.ConnectionString

# ---------- Worker (runs in each runspace) ----------
$worker = {
    param($Id, $ConnString, $Queries, $QueryTimeout, $Log, $Barrier, $BarrierWaitMs)

    function Write-Log($text, $color) {
        $Log.Enqueue([pscustomobject]@{
            Text  = ("[{0}] T{1,-3} {2}" -f (Get-Date -Format 'HH:mm:ss.fff'), $Id, $text)
            Color = $color
        })
    }

    $result = [pscustomobject]@{
        ThreadId     = $Id
        ConnectMs    = $null
        ConnectError = $null
        Queries      = New-Object System.Collections.ArrayList
    }
    $conn = New-Object System.Data.SqlClient.SqlConnection $ConnString

    try {
        # Connect
        $sw = [System.Diagnostics.Stopwatch]::StartNew()
        try {
            $conn.Open()
            $result.ConnectMs = $sw.Elapsed.TotalMilliseconds
            Write-Log ("connected in {0:N1} ms" -f $result.ConnectMs) 'Green'
        }
        catch {
            $result.ConnectError = $_.Exception.GetBaseException().Message -replace '\s+', ' '
            Write-Log ("CONNECT FAILED: {0}" -f $result.ConnectError) 'Red'
        }
        finally {
            [void]$Barrier.Signal()          # signal even on failure so other threads aren't held up
        }

        # Wait until every thread has attempted to connect, so queries start together
        [void]$Barrier.Wait($BarrierWaitMs)

        if ($null -ne $result.ConnectMs) {
            foreach ($q in @($Queries)) {
                $qr = [pscustomobject]@{ Label = $q.Label; Ms = $null; Rows = $null; Status = 'SKIPPED'; Error = $null }
                [void]$result.Queries.Add($qr)

                if ($conn.State -ne 'Open') {
                    $qr.Error = 'Connection no longer open'
                    Write-Log ("{0} skipped (connection no longer open)" -f $q.Label) 'Yellow'
                    continue
                }

                Write-Log ("{0} started" -f $q.Label) 'Gray'
                $cmd = $conn.CreateCommand()
                $cmd.CommandText    = $q.Text
                $cmd.CommandTimeout = $QueryTimeout
                $sw.Restart()
                try {
                    $qr.Rows   = $cmd.ExecuteNonQuery()
                    $qr.Ms     = $sw.Elapsed.TotalMilliseconds
                    $qr.Status = 'OK'
                    Write-Log ("{0} finished in {1:N1} s" -f $q.Label, ($qr.Ms / 1000)) 'Green'
                }
                catch {
                    $qr.Ms     = $sw.Elapsed.TotalMilliseconds
                    $qr.Status = 'FAILED'
                    $qr.Error  = $_.Exception.GetBaseException().Message -replace '\s+', ' '
                    Write-Log ("{0} FAILED after {1:N1} s: {2}" -f $q.Label, ($qr.Ms / 1000), $qr.Error) 'Red'
                }
                finally { $cmd.Dispose() }
            }
        }
    }
    finally {
        if ($conn.State -ne 'Closed') { $conn.Close() }
        $conn.Dispose()
    }
    $result
}

# ---------- Header ----------
Write-Host "Server      : $Server" -ForegroundColor Cyan
Write-Host "Database    : $Database" -ForegroundColor Cyan
Write-Host "Threads     : $ThreadCount ($QueryAssignment assignment)" -ForegroundColor Cyan
Write-Host ("Timeout     : {0}" -f $(if ($QueryTimeoutSeconds -eq 0) { 'none' } else { "$QueryTimeoutSeconds s" })) -ForegroundColor Cyan
Write-Host "Queries     :" -ForegroundColor Cyan
foreach ($q in $queryList) {
    $preview = ($q.Text -replace '\s+', ' ').Trim()
    if ($preview.Length -gt 80) { $preview = $preview.Substring(0, 77) + '...' }
    Write-Host ("  {0} [{1}] {2}" -f $q.Label, $q.Source, $preview) -ForegroundColor Cyan
}
Write-Host "Started     : $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')`n"

# ---------- Launch threads ----------
$log      = New-Object 'System.Collections.Concurrent.ConcurrentQueue[object]'
$barrier  = New-Object System.Threading.CountdownEvent $ThreadCount
$barrierWaitMs = ($ConnectTimeoutSeconds + 30) * 1000
$pool     = [runspacefactory]::CreateRunspacePool(1, $ThreadCount)
$pool.Open()
$jobs     = New-Object System.Collections.Generic.List[object]
$wallClock = [System.Diagnostics.Stopwatch]::StartNew()

function Show-Log {
    $item = $null
    while ($log.TryDequeue([ref]$item)) { Write-Host $item.Text -ForegroundColor $item.Color }
}

try {
    foreach ($i in 1..$ThreadCount) {
        $assigned = if ($QueryAssignment -eq 'RoundRobin') {
            , @($queryList[($i - 1) % $queryList.Count])
        } else {
            , @($queryList.ToArray())
        }
        $ps = [powershell]::Create()
        $ps.RunspacePool = $pool
        [void]$ps.AddScript($worker).
            AddArgument($i).AddArgument($connString).AddArgument($assigned[0]).
            AddArgument($QueryTimeoutSeconds).AddArgument($log).AddArgument($barrier).AddArgument($barrierWaitMs)
        $jobs.Add([pscustomobject]@{ Id = $i; PS = $ps; Handle = $ps.BeginInvoke() })
    }

    # ---------- Monitor ----------
    $lastBeat = [System.Diagnostics.Stopwatch]::StartNew()
    while (@($jobs | Where-Object { -not $_.Handle.IsCompleted }).Count -gt 0) {
        Show-Log
        if ($lastBeat.Elapsed.TotalSeconds -ge $HeartbeatSeconds) {
            $running = @($jobs | Where-Object { -not $_.Handle.IsCompleted }).Count
            Write-Host ("  ...{0} of {1} threads still running ({2:mm\:ss} elapsed)" -f $running, $ThreadCount, $wallClock.Elapsed) -ForegroundColor DarkGray
            $lastBeat.Restart()
        }
        Start-Sleep -Milliseconds 250
    }
    $wallClock.Stop()
    Show-Log

    # ---------- Collect ----------
    $results = foreach ($j in $jobs) {
        $out = $j.PS.EndInvoke($j.Handle)
        foreach ($e in $j.PS.Streams.Error) { Write-Host ("T{0} unexpected error: {1}" -f $j.Id, $e) -ForegroundColor Red }
        $out
    }
}
finally {
    foreach ($j in $jobs) { if (-not $j.Handle.IsCompleted) { $j.PS.Stop() }; $j.PS.Dispose() }
    $pool.Close(); $pool.Dispose()
    $barrier.Dispose()
}

# ---------- Report ----------
$rows = foreach ($r in ($results | Sort-Object ThreadId)) {
    $connText = if ($null -ne $r.ConnectMs) { '{0:N1}' -f $r.ConnectMs } else { 'FAILED' }
    if ($r.Queries.Count -eq 0) {
        [pscustomobject]@{ Thread = $r.ThreadId; 'Connect (ms)' = $connText; Query = '-'; 'Query time' = '-'; Status = 'NO CONNECTION'; Error = $r.ConnectError }
    }
    foreach ($qr in $r.Queries) {
        $t = if ($null -ne $qr.Ms) { '{0:hh\:mm\:ss\.f}' -f [timespan]::FromMilliseconds($qr.Ms) } else { '-' }
        [pscustomobject]@{ Thread = $r.ThreadId; 'Connect (ms)' = $connText; Query = $qr.Label; 'Query time' = $t; Status = $qr.Status; Error = $qr.Error }
    }
}

Write-Host "`n=========== RESULTS ===========" -ForegroundColor Cyan
$rows | Format-Table Thread, 'Connect (ms)', Query, 'Query time', Status, Error -AutoSize | Out-Host

# Aggregates per query (successful runs only)
$allQ = foreach ($r in $results) { foreach ($qr in $r.Queries) { $qr } }
$okQ  = @($allQ | Where-Object { $_.Status -eq 'OK' })
if ($okQ.Count) {
    Write-Host "Per-query timing across threads (successful runs):" -ForegroundColor Cyan
    foreach ($g in ($okQ | Group-Object Label | Sort-Object Name)) {
        $m = $g.Group.Ms | Measure-Object -Average -Minimum -Maximum
        Write-Host ("  {0}: {1} run(s)  min {2:N1} s  avg {3:N1} s  max {4:N1} s" -f $g.Name, $g.Count, ($m.Minimum / 1000), ($m.Average / 1000), ($m.Maximum / 1000))
    }
}

$connOk = @($results | Where-Object { $null -ne $_.ConnectMs })
if ($connOk.Count) {
    $c = $connOk.ConnectMs | Measure-Object -Average -Minimum -Maximum
    Write-Host ("`nConnection time ({0} of {1} connected): min {2:N1} ms  avg {3:N1} ms  max {4:N1} ms" -f $connOk.Count, $ThreadCount, $c.Minimum, $c.Average, $c.Maximum)
}

$failed = @($rows | Where-Object { $_.Status -in 'FAILED', 'NO CONNECTION' }).Count
Write-Host ("Wall-clock total: {0:hh\:mm\:ss\.fff}" -f $wallClock.Elapsed)
if ($failed) {
    Write-Host "Status: $failed failure(s)" -ForegroundColor Red
    exit 1
}
Write-Host "Status: ALL SUCCEEDED" -ForegroundColor Green
